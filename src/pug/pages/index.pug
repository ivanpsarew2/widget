            { href: 'appointment-upcoming.html', label: 'Предстоящая запись', name: 'appointment-upcoming.html' },
            { href: 'appointment-past.html', label: 'Прошедшая запись', name: 'appointment-past.html' },
            { href: 'bonuses.html', label: 'Бонусы', name: 'bonuses.html' },
            { href: 'tickets.html', label: 'Абонементы', name: 'tickets.html' },
            { href: 'certificates.html', label: 'Депозиты и сертификаты', name: 'certificates.html' },
            { href: 'cookie.html', label: 'Cookie', name: 'cookie.html' }
        ]

    .main.page-list
        .page-list__shell
            header.page-list__header
                h1.page-list__title Все страницы
                p.page-list__subtitle Быстрая навигация по доступным экранам виджета

            main.page-list__content
                .page-list__links
                    each item in pages
                        a.page-list__link(href=item.href)
                            span.page-list__link-label= item.label
                            span.page-list__link-name= item.name
