        const pages = [
            { href: 'example.html', label: 'UI-kit', name: 'example.html' },
            { href: 'home.html', label: 'Главная', name: 'home.html' },
            { href: 'info.html', label: 'Информация о специалисте', name: 'info.html' },
            { href: 'reschedule.html', label: 'Перенос записи', name: 'reschedule.html' },
            { href: 'specialist-selected.html', label: 'Выбрана услуга', name: 'specialist-selected.html' },
            { href: 'specialist-selected-edit.html', label: 'Редактирование выбранных услуг', name: 'specialist-selected-edit.html' },
            { href: 'specialist-day.html', label: 'Выбор даты и времени', name: 'specialist-day.html' },
