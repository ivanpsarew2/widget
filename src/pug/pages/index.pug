            { href: 'contacts-drink.html', label: 'Выбор напитка', name: 'contacts-drink.html' },
            { href: 'contacts-reminder.html', label: 'Выбор напоминания', name: 'contacts-reminder.html' },
            { href: 'success.html', label: 'Успешная запись', name: 'success.html' },
            { href: 'cancel.html', label: 'Попап отмены записи', name: 'cancel.html' },
            { href: 'canceled.html', label: 'Запись отменена', name: 'canceled.html' },
            { href: 'login-step-1.html', label: 'Личный кабинет', name: 'login-step-1.html' },
            { href: 'login-step-2.html', label: 'Вход по коду', name: 'login-step-2.html' },
            { href: 'login-step-2-pass.html', label: 'Вход с паролем', name: 'login-step-2-pass.html' },
            { href: 'login-step-3.html', label: 'SMS-код', name: 'login-step-3.html' },
            { href: 'language.html', label: 'Выбор языка', name: 'language.html' },
