extends ../layout
include ../components/booking-summary
include ../components/service-selection-page

block variables
    - var page = 'specialist-selected'

block content
    +serviceSelectionPage({
        className: 'index-page_selected',
        checkedFirst: true
    })
        +bookingSummary({
            className: 'index-page__summary',
            count: '1 услуга',
            duration: '60 мин',
            price: '2 300 – 4 000 ₽',
            actionLabel: 'Выбрать дату и время'
        })
