include ./action-buttons
include ./appointment-services
include ./appointment-status
include ./button
include ./checkbox
include ./info-row
include ./item-banner
include ./map-preview
include ./powered-by
include ./social-links
include ./specialist-topbar
include ../icons/icon-close
include ../icons/icon-smiley

mixin successPage(options)
    - options = options || {}
    - const mode = options.mode || 'success'
    - const isCanceled = mode === 'canceled'
    - const extraClass = options.className || ''
    - const pageClasses = ['main', 'success']
    - if (isCanceled) pageClasses.push('success_canceled')
    - if (extraClass) pageClasses.push(extraClass)
    - const showActions = options.showActions !== undefined ? options.showActions : !isCanceled
    - const showServices = options.showServices !== undefined ? options.showServices : !isCanceled
    - const showBookButton = options.showBookButton !== undefined ? options.showBookButton : isCanceled
    - const showBonus = Boolean(options.showBonus)
    - const status = options.status || (isCanceled ? { variant: 'danger', label: 'Запись отменена', icon: 'close' } : { label: 'Вы записаны' })

    div(class=pageClasses)&attributes(attributes)
        .success__shell
            +specialistTopbar({
                className: 'success__topbar',
                href: 'contacts.html'
            })

            main.success__content
                .success__banners.item-banners
                    +itemBanner({ className: 'success__banner', label: 'Text banner' })
                        +icon-smiley('item-banner__slot-icon')
                    +itemBanner({ className: 'success__banner', label: 'Text banner' })
                        +icon-smiley('item-banner__slot-icon')

                section.success__status
                    +appointmentStatus(status)

                    .success__datetime
                        h1.success__date Четверг, 5 марта
                        .success__time 10:00 – 12:00

                if showActions
                    +actionButtons({
                        className: 'success__actions',
                        items: [
                            {
                                label: 'Записаться еще',
                                variant: 'primary',
                                icon: 'plus'
                            },
                            {
                                label: 'Добавить в календарь',
                                icon: 'calendar'
                            },
                            {
                                label: 'Перенести запись',
                                icon: 'reschedule'
                            },
                            {
                                label: 'Отменить запись',
                                icon: 'close'
                            }
                        ]
                    })

                if showBookButton
                    +button({ label: 'Записаться ещё' })

                if showServices
                    section.success__section
                        +appointmentServices({ services: [
                            {
                                title: 'Женская стрижка (короткие)',
                                duration: '60 мин',
                                price: '2 300 – 4 000 ₽',
                                info: true
                            },
                            {
                                title: 'Женская стрижка (средние)',
                                duration: '60 мин',
                                price: '2 500 – 4 000 ₽',
                                info: true
                            }
                        ] })

                section.success__section
                    h2.success__section-title Контакты

                    .success__contacts
                        +infoRow({ icon: 'pin', copy: true })
                            | г. Новоконстантиновск,
                            br
                            | м. Метрополитен,
                            br
                            | ул. Шарикоподшипниковская,
                            br
                            | д. 39, корп. 12

                        +mapPreview()

                        +infoRow({ icon: 'phone', text: '+7 (555) 555-55-55' })
                        +infoRow({ icon: 'globe', text: 'beautysalon.ru' })

                        +socialLinks()

                if showBonus
                    section.success__bonus
                        +checkbox({ name: 'bonuses', checked: true, content: true })
                            span Вам зачислили бонусы за запись
                        +button({ label: 'Забрать', variant: 'link' })

                footer.success__footer
                    +poweredBy()

        if block
            block
