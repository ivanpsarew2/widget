include ./button
include ../icons/icon-pencil

mixin bookingSummary(options)
    - options = options || {}
    - const label = options.label
    - const value = options.value
    - const count = options.count || '1 услуга'
    - const duration = options.duration || '60 мин'
    - const price = options.price || '0 ₽'
    - const actionLabel = options.actionLabel || 'Выбрать дату и время'
    - const edit = options.edit !== false && !label
    - const extraClass = options.className || ''
    - const summaryClasses = ['booking-summary']
    - if (label) summaryClasses.push('booking-summary_date')
    - if (extraClass) summaryClasses.push(extraClass)

    div(class=summaryClasses)&attributes(attributes)
        .booking-summary__details
            if label
                .booking-summary__label= label
                .booking-summary__value= value
            else
                .booking-summary__meta
                    span.booking-summary__count= count
                    span.booking-summary__duration= duration
                .booking-summary__price= price
                if edit
                    button.booking-summary__edit(type="button")
                        +icon-pencil('booking-summary__edit-icon')

        +button({ label: actionLabel, className: 'booking-summary__button' })
