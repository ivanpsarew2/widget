include ./march-calendar
include ./specialist-topbar
include ./time-slots

mixin specialistDayPicker(options)
    - options = options || {}
    - const selectedDay = options.selectedDay || ''
    - const selectedTimes = options.selectedTimes || []
    - const extraClass = options.className || ''
    - const pickerClasses = ['specialist__picker']
    - if (extraClass) pickerClasses.push(extraClass)
    -
        const morningSlots = ['10:00', '10:15', '10:30', '10:45', '11:30', '11:45'].map(function(label) {
            return {
                label,
                selected: selectedTimes.includes(label)
            }
        })
        const daySlots = ['12:00', '12:15', '12:30', '12:45', '13:00', '13:15', '13:30', '13:45'].map(function(label) {
            return {
                label,
                selected: selectedTimes.includes(label)
            }
        })

    div(class=pickerClasses)&attributes(attributes)
        +specialistTopbar({
            className: 'specialist__picker-topbar',
            href: 'specialist-selected.html'
        })

        main.specialist__picker-content
            +marchCalendar({
                className: 'specialist__picker-calendar',
                selectedDay
            })

            +timeSlots({
                className: 'specialist__picker-time-section',
                title: 'Утро',
                items: morningSlots
            })

            +timeSlots({
                className: 'specialist__picker-time-section',
                title: 'День',
                items: daySlots
            })
