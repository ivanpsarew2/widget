extends ../layout
include ../templates/select-sheet

block variables
    - var page = 'language'
    - var bodyClass = 'body-lock'

block content
    .main.language-page
        +selectSheet({
            title: 'Выберите значение из списка',
            className: 'select-sheet_compact',
            items: [
                {
                    label: 'Русский',
                    selected: true
                },
                'Английский'
            ]
        })
