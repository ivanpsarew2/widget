include ./bottom-sheet
include ../components/dropdown-list-item
include ../components/input

mixin selectSheet(options)
    - options = options || {}
    - const items = options.items || []
    - const withSearch = Boolean(options.search)
    - const searchPlaceholder = options.searchPlaceholder || 'Найти'
    - const title = options.title === false ? false : (options.title || 'Выберите значение из списка')

    +bottomSheet({
        title: title,
        close: options.close,
        overlay: options.overlay,
        className: options.className
    })&attributes(attributes)
        if withSearch
            +inputField({
                className: 'select-sheet__search',
                search: true,
                type: 'search',
                placeholder: searchPlaceholder
            })

        .select-sheet__list
            each item in items
                - const itemLabel = typeof item === 'string' ? item : item.label
                - const selected = typeof item === 'object' && item.selected
                +dropdownListItem({ label: itemLabel, selected: selected })
