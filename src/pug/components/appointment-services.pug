include ../icons/icon-info

mixin appointmentServices(options)
    - options = options || {}
    - const services = options.services || []
    - const extraClass = options.className || ''
    - const servicesClasses = ['appointment-services']
    - if (extraClass) servicesClasses.push(extraClass)

    div(class=servicesClasses)&attributes(attributes)
        h2.appointment-services__title Услуги

        .appointment-services__list
            each service in services
                -
                    const serviceClasses = ['appointment-services__service']
                    if (service.info) serviceClasses.push('appointment-services__service_has-info')

                div(class=serviceClasses)
                    .appointment-services__service-main
                        .appointment-services__service-title= service.title
                        if service.duration
                            .appointment-services__service-duration= service.duration
                    .appointment-services__service-price= service.price
                    if service.info
                        button.appointment-services__service-info(type="button")
                            +icon-info('appointment-services__service-info-icon')
