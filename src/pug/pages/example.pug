extends ../layout
include ../templates/widget-screen
include ../templates/select-sheet
include ../components/appointment-status
include ../components/button
include ../components/chips
include ../components/checkbox
include ../components/calendar-day
include ../components/calendar
include ../components/dropdown-list-item
include ../components/item-appointment
include ../components/item-balance-card
include ../components/item-tab
include ../components/item-review
include ../components/item-banner
include ../components/item-service
include ../components/item-user
include ../components/input
include ../components/textarea
include ../icons/icon-smiley

block variables
    - var page = 'example'

block content
    .main
        section.example-section
            h1.example-section__title Button

            .example-section__grid
                .example-section__item
                    p.example-section__label Primary
                    +button({ label: 'Button', variant: 'primary' })

                .example-section__item
                    p.example-section__label Primary active
                    +button({ label: 'Button', variant: 'primary', active: true })

                .example-section__item
                    p.example-section__label Secondary
                    +button({ label: 'Button', variant: 'secondary' })

                .example-section__item
                    p.example-section__label Secondary active
                    +button({ label: 'Button', variant: 'secondary', active: true })

                .example-section__item
                    p.example-section__label Third
                    +button({ label: 'Button', variant: 'third' })

                .example-section__item
                    p.example-section__label Third active
                    +button({ label: 'Button', variant: 'third', active: true })

        section.example-section
            h2.example-section__title Button Operation

            .example-section__grid.example-section__grid--operation
                .example-section__item
                    p.example-section__label Primary
                    +button({ label: 'Button', variant: 'primary', operation: true })

                .example-section__item
                    p.example-section__label Primary active
                    +button({ label: 'Button', variant: 'primary', operation: true, active: true })

                .example-section__item
                    p.example-section__label Secondary
                    +button({ label: 'Button', variant: 'secondary', operation: true })

                .example-section__item
                    p.example-section__label Secondary active
                    +button({ label: 'Button', variant: 'secondary', operation: true, active: true })

                .example-section__item
                    p.example-section__label Third
                    +button({ label: 'Button', variant: 'third', operation: true })

        section.example-section
            h2.example-section__title Item Tab

            .example-section__tabs
                +itemTab({ label: 'Tab' })
                +itemTab({ label: 'Tab', active: true })
                +itemTab({ label: 'Tab', selected: true })

            .example-section__tabs-example
                +itemTabs({
                    items: [
                        { label: 'Вход по коду', selected: true },
                        { label: 'Вход с паролем' }
                    ]
                })

        section.example-section
            h2.example-section__title Chips

            .example-section__chips
                +chips({
                    items: [
                        { label: 'Text' },
                        { label: 'Text', active: true },
                        { label: 'Text', selected: true }
                    ]
                })

            .example-section__chips-example
                +chips({
                    items: [
                        { label: 'Стрижки', selected: true },
                        { label: 'Укладки' },
                        { label: 'Уход' },
                        { label: 'Окрашивание' },
                        { label: 'Брови' },
                        { label: 'Маникюр' }
                    ]
                })

        section.example-section
            h2.example-section__title Checkbox

            .example-section__checkboxes
                +checkbox
                +checkbox({ active: true })
                +checkbox({ checked: true })

            .example-section__checkbox-list
                +checkbox({
                    label: 'Text',
                    description: 'Description'
                })
                +checkbox({
                    label: 'Text',
                    description: 'Description',
                    active: true
                })
                +checkbox({
                    label: 'Text',
                    description: 'Description',
                    error: true
                })

        section.example-section
            h2.example-section__title Calendar Day

            .example-section__calendar-days
                +calendarDay({ dayType: 'workday' })
                +calendarDay({ dayType: 'weekend' })
                +calendarDay({ dayType: 'workday', today: true })
                +calendarDay({ dayType: 'weekend', today: true })
                +calendarDay({ dayType: 'workday', disabled: true })
                +calendarDay({ dayType: 'weekend', disabled: true })
                +calendarDay({ dayType: 'workday', disabled: true, today: true })
                +calendarDay({ dayType: 'weekend', disabled: true, today: true })

            .example-section__calendar-days
                +calendarDay({ dayType: 'workday', state: 'hover' })
                +calendarDay({ dayType: 'weekend', state: 'hover' })
                +calendarDay({ dayType: 'workday', state: 'hover', today: true })
                +calendarDay({ dayType: 'weekend', state: 'hover', today: true })
                +calendarDay({ dayType: 'workday', state: 'selected' })
                +calendarDay({ dayType: 'weekend', state: 'selected' })
                +calendarDay({ dayType: 'workday', state: 'selected', disabled: true })
                +calendarDay({ dayType: 'weekend', state: 'selected', disabled: true })

        section.example-section
            h2.example-section__title Calendar

            .example-section__calendar
                +calendar({
                    title: 'Март 2026',
                    days: [
                        { label: '23', dayType: 'workday', disabled: true },
                        { label: '24', dayType: 'workday', disabled: true },
                        { label: '25', dayType: 'workday' },
                        { label: '26', dayType: 'workday' },
                        { label: '27', dayType: 'workday', disabled: true },
                        { label: '28', dayType: 'weekend', disabled: true },
                        { label: '1', dayType: 'weekend' },
                        { label: '2', dayType: 'workday' },
                        { label: '3', dayType: 'workday', today: true },
                        { label: '4', dayType: 'workday', disabled: true },
                        { label: '5', dayType: 'workday' },
                        { label: '6', dayType: 'workday' },
                        { label: '7', dayType: 'weekend', disabled: true },
                        { label: '8', dayType: 'weekend', disabled: true },
                        { label: '9', dayType: 'workday' },
                        { label: '10', dayType: 'workday' },
                        { label: '11', dayType: 'workday', disabled: true },
                        { label: '12', dayType: 'workday', disabled: true },
                        { label: '13', dayType: 'workday' },
                        { label: '14', dayType: 'weekend' },
                        { label: '15', dayType: 'weekend', disabled: true },
                        { label: '16', dayType: 'workday', disabled: true },
                        { label: '17', dayType: 'workday' },
                        { label: '18', dayType: 'workday' },
                        { label: '19', dayType: 'workday', disabled: true },
                        { label: '20', dayType: 'workday', disabled: true },
                        { label: '21', dayType: 'weekend' },
                        { label: '22', dayType: 'weekend' },
                        { label: '23', dayType: 'workday', disabled: true },
                        { label: '24', dayType: 'workday', disabled: true },
                        { label: '25', dayType: 'workday' },
                        { label: '26', dayType: 'workday' },
                        { label: '27', dayType: 'workday', disabled: true },
                        { label: '28', dayType: 'weekend', disabled: true },
                        { label: '29', dayType: 'weekend' },
                        { label: '30', dayType: 'workday' },
                        { label: '31', dayType: 'workday', disabled: true },
                        { label: '1', dayType: 'workday', disabled: true },
                        { label: '2', dayType: 'workday' },
                        { label: '3', dayType: 'workday' },
                        { label: '4', dayType: 'weekend', disabled: true },
                        { label: '5', dayType: 'weekend', disabled: true }
                    ]
                })

        section.example-section
            h2.example-section__title Item Dropdown List

            .example-section__dropdown-list
                +dropdownListItem({ label: '+000 (Country)' })
                +dropdownListItem({ label: '+000 (Country)', hover: true })
                +dropdownListItem({ label: '+000 (Country)', selected: true })

        section.example-section
            h2.example-section__title Item Review

            .example-section__review
                +itemReview({
                    initials: 'Nm',
                    name: 'Client name',
                    rating: 4,
                    date: '00 месяц 0000',
                    text: 'Review text'
                })

        section.example-section
            h2.example-section__title Item Banner

            .example-section__banner
                +itemBanner({ label: 'Text banner' })
                    +icon-smiley('item-banner__slot-icon')

            .example-section__banners
                .item-banners
                    +itemBanner({ label: 'Text banner' })
                        +icon-smiley('item-banner__slot-icon')

        section.example-section
            h2.example-section__title Item Service

            .example-section__service
                +itemService({
                    title: 'Service name',
                    duration: 'Clock',
                    description: 'Description',
                    price: '0 ₽'
                })

                +selectedService({
                    title: 'Service name',
                    duration: 'Clock',
                    description: 'Description',
                    price: '0 ₽'
                })
                    +itemBanner({ label: 'Text banner' })
                        +icon-smiley('item-banner__slot-icon')

        section.example-section
            h2.example-section__title Item User

            .example-section__user
                +itemUser({
                    initials: 'Us',
                    name: 'User name',
                    phone: '+7 (000) 000-00-00',
                    email: 'mymail@mail.ru'
                })

        section.example-section
            h2.example-section__title Item Appointment

            .example-section__appointments
                +itemAppointment({
                    date: 'Дн, 00 мес в 00:00',
                    name: 'Name',
                    qualification: 'Qualification',
                    services: ['Service name', 'Service name'],
                    price: 'Price'
                })
                +itemAppointment({
                    date: 'Вс, 15 мар в 18:30',
                    avatar: 'img/avatar.jpg',
                    name: 'Мария',
                    qualification: 'Топ-стилист',
                    services: ['Женская стрижка (короткие)'],
                    price: '7 500 ₽',
                    status: {
                        label: 'Завершена'
                    },
                    action: {
                        label: 'Записаться снова',
                        variant: 'secondary',
                        icon: 'reload'
                    }
                })
                +itemAppointment({
                    date: 'Вс, 15 мар в 18:30',
                    avatar: 'img/avatar.jpg',
                    name: 'Мария',
                    qualification: 'Топ-стилист',
                    services: ['Женская стрижка (короткие)'],
                    price: '7 500 ₽',
                    status: {
                        variant: 'danger',
                        label: 'Отменена'
                    },
                    action: {
                        label: 'Записаться снова',
                        variant: 'secondary',
                        icon: 'reload'
                    }
                })

        section.example-section
            h2.example-section__title Item Balance Card

            .example-section__balance-cards
                +itemBalanceCard({
                    title: 'Абонемент на 10 дневных макияжей',
                    subtitle: 'Абонемент №725',
                    balance: 'Остаток 8 услуг'
                })
                +itemBalanceCard({
                    title: 'Сертификат 10 000 ₽ на все услуги',
                    subtitle: 'Сертификат №734',
                    balance: 'Остаток 6 300 ₽'
                })
                +itemBalanceCard({
                    title: 'Депозит',
                    balance: 'Остаток 7 200 ₽'
                })

        section.example-section
            h2.example-section__title Item Status Appointment

            .example-section__statuses
                +appointmentStatus({ label: 'Завершена' })
                +appointmentStatus({ variant: 'danger', label: 'Отменена' })

        section.example-section
            h2.example-section__title Input Search

            .example-section__inputs
                +inputField({ label: 'Default empty', search: true })
                +inputField({ label: 'Hover empty', search: true, hover: true })
                +inputField({ label: 'Active edit', search: true, active: true, value: 'Text' })
                +inputField({ label: 'Default filled', search: true, value: 'Text' })
                +inputField({ label: 'Hover filled', search: true, value: 'Text', hover: true })

        section.example-section
            h2.example-section__title Input

            .example-section__inputs
                +inputField({ label: 'Default empty' })
                +inputField({ label: 'Hover empty', hover: true })
                +inputField({ label: 'Edit active', active: true, value: 'Text' })
                +inputField({ label: 'Default filled', value: 'Text' })
                +inputField({ label: 'Hover filled', value: 'Text', hover: true })
                +inputField({ label: 'Error empty', error: true })
                +inputField({ label: 'Error active', error: true, active: true, value: 'Text' })
                +inputField({ label: 'Error filled', error: true, value: 'Text' })
                    +itemBanner({ label: 'Text banner' })
                        +icon-smiley('item-banner__slot-icon')

        section.example-section
            h2.example-section__title Textarea

            .example-section__inputs
                +textareaField({ label: 'Default empty' })
                +textareaField({ label: 'Hover empty', hover: true })
                +textareaField({ label: 'Edit active', active: true, value: 'Text' })
                +textareaField({ label: 'Default filled', value: 'Text' })
                +textareaField({ label: 'Hover filled', value: 'Text', hover: true })
                +textareaField({ label: 'Error empty', error: true })
                +textareaField({ label: 'Error active', error: true, active: true, value: 'Text' })
                +textareaField({ label: 'Error filled', error: true, value: 'Text' })
