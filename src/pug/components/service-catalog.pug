include ./chips
include ./service-section

mixin serviceCatalog(options)
    - options = options || {}
    - const chipsClassName = options.chipsClassName || ''
    - const sectionClassName = options.sectionClassName || ''
    - const bottomSectionClassName = options.bottomSectionClassName || ''
    - const checkedFirst = Boolean(options.checkedFirst)
    -
        const serviceGroups = [
            {
                id: 'service-haircuts',
                label: 'Стрижки',
                selected: true,
                items: [
                    {
                        title: 'Женская стрижка (короткие)',
                        duration: '60 мин',
                        description: '',
                        price: '2 300 – 4 000 ₽'
                    },
                    {
                        title: 'Женская стрижка (средние)',
                        duration: '60 мин',
                        description: 'Стрижка может быть различной формы и сложности, в зависимости от желаемого результата и особенностей клиента',
                        price: '2 500 – 4 000 ₽'
                    }
                ]
            },
            {
                id: 'service-styling',
                label: 'Укладки',
                items: [
                    {
                        title: 'Укладка повседневная',
                        duration: '60 мин',
                        description: '',
                        price: 'от 1 500 ₽'
                    },
                    {
                        title: 'Коктейльная укладка',
                        duration: '60 мин',
                        description: '',
                        price: 'от 2 000 ₽'
                    }
                ]
            },
            {
                id: 'service-care',
                label: 'Уход',
                items: [
                    {
                        title: 'Восстановление волос',
                        duration: '45 мин',
                        description: '',
                        price: 'от 2 200 ₽'
                    },
                    {
                        title: 'Уход для кожи головы',
                        duration: '40 мин',
                        description: '',
                        price: 'от 1 800 ₽'
                    }
                ]
            },
            {
                id: 'service-coloring',
                label: 'Окрашивание',
                items: [
                    {
                        title: 'Окрашивание в один тон',
                        duration: '120 мин',
                        description: '',
                        price: 'от 5 000 ₽'
                    },
                    {
                        title: 'Тонирование волос',
                        duration: '90 мин',
                        description: '',
                        price: 'от 3 500 ₽'
                    }
                ]
            },
            {
                id: 'service-brows',
                label: 'Брови',
                items: [
                    {
                        title: 'Коррекция бровей',
                        duration: '30 мин',
                        description: '',
                        price: 'от 900 ₽'
                    },
                    {
                        title: 'Окрашивание бровей',
                        duration: '30 мин',
                        description: '',
                        price: 'от 1 000 ₽'
                    }
                ]
            },
            {
                id: 'service-nails',
                label: 'Маникюр',
                items: [
                    {
                        title: 'Маникюр классический',
                        duration: '60 мин',
                        description: '',
                        price: 'от 1 700 ₽'
                    },
                    {
                        title: 'Маникюр с покрытием',
                        duration: '90 мин',
                        description: '',
                        price: 'от 2 500 ₽'
                    }
                ]
            }
        ]

    +chips({
        className: chipsClassName,
        items: serviceGroups.map(function(group) {
            return {
                label: group.label,
                selected: group.selected,
                href: `#${group.id}`
            }
        })
    })

    each group, groupIndex in serviceGroups
        -
            const currentSectionClasses = [sectionClassName]
            if (groupIndex > 0 && bottomSectionClassName) currentSectionClasses.push(bottomSectionClassName)
            const currentItems = group.items.map(function(item, itemIndex) {
                const currentItem = Object.assign({}, item)
                if (checkedFirst && groupIndex === 0 && itemIndex === 0) currentItem.checked = true
                return currentItem
            })

        +serviceSection({
            className: currentSectionClasses.filter(Boolean).join(' '),
            title: group.label,
            items: currentItems
        })(id=group.id)
